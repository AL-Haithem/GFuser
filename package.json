{
  "name": "GFuser",
  "version": "1.0.9",
  "private": true,
  "description": "A desktop app shell for project management and software updates.",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "dev": "concurrently -k --success command-1 \"vite --host 127.0.0.1 --port 4173 --strictPort\" \"wait-on http://127.0.0.1:4173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .\"",
    "build:ui": "vite build",
    "check": "node --check main.js && node --check preload.js && vite build",
    "dist": "npm run build:ui && electron-builder --win --dir",
    "build": "npm run build:ui && electron-builder --win --dir",
    "build:installer": "npm run build:ui && electron-builder --win nsis"
  },

  "repository": "https://github.com/AL-Haithem/GFuser",

  "publish": {
    "provider": "github",
    "releaseType": "release"
  },

  "build": {
    "appId": "site.alhaihem.gfuser",
    "productName": "GFuser",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/nsis/custom.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
