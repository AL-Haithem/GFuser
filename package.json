{
  "name": "mapfusiondesktop",
  "version": "1.0.2",
  "private": true,
  "description": "A desktop workspace for inspecting and preparing geographic datasets.",
  "main": "main.js",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "dev": "concurrently -k --success first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:ui": "vite build",
    "start:merged": "node scripts/runMergedProject.js",
    "check": "node --check main.js && node --check preload.js && node --check scripts/runMergedProject.js && vite build",
    "dist": "npm run build:ui && electron-builder --win --dir",
    "build": "npm run build:ui && electron-builder --win --dir",
    "build:installer": "npm run build:ui && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mapfusiondesktop.app",
    "productName": "MapFusionDesktop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "AL-Haithem",
      "repo": "GEOProcessing",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
